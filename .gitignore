# Third-party driver binaries (place WinDivert.dll next to the exe at runtime)
WinDivert.dll
WinDivert*.sys
WinDivert*.lib
WinDivert*.h

# The packaged copies are the exception: CI cannot download them, so the
# release build takes them from here.
!vendor/windivert/WinDivert.dll
!vendor/windivert/WinDivert64.sys

# Scratch scripts used while debugging (never part of the source tree)
/_*.ps1
/_*.cmd
/_*.mjs
/_*.py

# Build output
/target

# Packaged binaries: published through GitHub Releases, not through git.
# Committing a ~20 MB exe on every rebuild bloats the repository history.
/dist

